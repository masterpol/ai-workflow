{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "Portable wiring template for the current hook set. This file is NOT auto-loaded \u2014 copy the entries you want into .claude/settings.json (or settings.local.json) to activate them. pre-ship-verify.mts is not an event hook; it is a script the /ship phase runs.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types --disable-warning=ExperimentalWarning \"$CLAUDE_PROJECT_DIR/ai-framework/hooks/scripts/workflow-notice.mts\" dev-server"
          }
        ],
        "description": "Block dev servers outside tmux - ensures you can access logs"
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types --disable-warning=ExperimentalWarning \"$CLAUDE_PROJECT_DIR/ai-framework/hooks/scripts/workflow-notice.mts\" push"
          }
        ],
        "description": "Reminder before git push to review changes"
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "AI_WORKFLOW_RUNNER=node node --experimental-strip-types --disable-warning=ExperimentalWarning \"$CLAUDE_PROJECT_DIR/ai-framework/hooks/scripts/orca-start-hook.mts\"",
            "timeout": 8
          }
        ],
        "description": "Check Orca readiness before workflow phases; block when requested but unavailable"
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types --disable-warning=ExperimentalWarning \"$CLAUDE_PROJECT_DIR/ai-framework/hooks/scripts/stuck-uphill-detector.mts\""
          }
        ],
        "description": "Scan active pitches' hill charts; warn about scopes stuck at the same uphill position across 3+ sessions"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "AI_WORKFLOW_RUNNER=node node --experimental-strip-types --disable-warning=ExperimentalWarning \"$CLAUDE_PROJECT_DIR/ai-framework/hooks/scripts/workflow-capture.mts\" --vendor claude --root \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 5
          }
        ],
        "description": "Record workflow activity metadata without prompt, response or transcript text"
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types --disable-warning=ExperimentalWarning \"$CLAUDE_PROJECT_DIR/ai-framework/hooks/scripts/token-consumption.mts\" --vendor claude --event subagent-complete --root \"$CLAUDE_PROJECT_DIR\""
          }
        ],
        "description": "Record a bounded local consumption snapshot when any subagent finishes"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "AI_WORKFLOW_RUNNER=node node --experimental-strip-types --disable-warning=ExperimentalWarning \"$CLAUDE_PROJECT_DIR/ai-framework/hooks/scripts/workflow-capture.mts\" --vendor claude --root \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 5
          }
        ],
        "description": "Record workflow activity metadata without prompt, response or transcript text"
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types --disable-warning=ExperimentalWarning \"$CLAUDE_PROJECT_DIR/ai-framework/hooks/scripts/token-consumption.mts\" --vendor claude --event agent-result --root \"$CLAUDE_PROJECT_DIR\""
          }
        ],
        "description": "Supplement foreground agent completions with Claude's final-request usage when available"
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types --disable-warning=ExperimentalWarning \"$CLAUDE_PROJECT_DIR/ai-framework/hooks/scripts/token-consumption.mts\" --vendor claude --event skill-use --root \"$CLAUDE_PROJECT_DIR\""
          }
        ],
        "description": "Count skill invocations by name only; the skill's arguments are never stored"
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types --disable-warning=ExperimentalWarning \".claude/hooks/post-edit-check.mts\""
          }
        ],
        "description": "Deterministic post-edit quality gate: secrets, console.log, oversized components, missing auth guards, boundary + client-hook violations, TS syntax"
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types --disable-warning=ExperimentalWarning \"$CLAUDE_PROJECT_DIR/ai-framework/hooks/scripts/workflow-notice.mts\" pull-request"
          }
        ],
        "description": "Log PR URL and provide review command after PR creation"
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "AI_WORKFLOW_RUNNER=node node --experimental-strip-types --disable-warning=ExperimentalWarning \"$CLAUDE_PROJECT_DIR/ai-framework/hooks/scripts/workflow-capture.mts\" --vendor claude --root \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 5
          }
        ],
        "description": "Record workflow activity metadata without prompt, response or transcript text"
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "AI_WORKFLOW_RUNNER=node node --experimental-strip-types --disable-warning=ExperimentalWarning \"$CLAUDE_PROJECT_DIR/ai-framework/hooks/scripts/orca-start-hook.mts\"",
            "timeout": 8
          }
        ],
        "description": "Check Orca readiness before workflow phases; block when requested but unavailable"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types --disable-warning=ExperimentalWarning \"$CLAUDE_PROJECT_DIR/ai-framework/hooks/scripts/token-consumption.mts\" --vendor claude --event phase-start --root \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 8
          }
        ],
        "description": "Record which pitch, phase and scope a workflow command starts (names only; arguments are never stored)"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "AI_WORKFLOW_RUNNER=node node --experimental-strip-types --disable-warning=ExperimentalWarning \"$CLAUDE_PROJECT_DIR/ai-framework/hooks/scripts/workflow-capture.mts\" --vendor claude --root \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 5
          }
        ],
        "description": "Record workflow activity metadata without prompt, response or transcript text"
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node --experimental-strip-types --disable-warning=ExperimentalWarning \"$CLAUDE_PROJECT_DIR/ai-framework/hooks/scripts/token-consumption.mts\" --vendor claude --event session-turn --root \"$CLAUDE_PROJECT_DIR\""
          }
        ],
        "description": "Record the main session's usage for the turn that just ended (token counts from the transcript only)"
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "AI_WORKFLOW_RUNNER=node node --experimental-strip-types --disable-warning=ExperimentalWarning \"$CLAUDE_PROJECT_DIR/ai-framework/hooks/scripts/workflow-capture.mts\" --vendor claude --root \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 5
          }
        ],
        "description": "Record workflow activity metadata without prompt, response or transcript text"
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "AI_WORKFLOW_RUNNER=node node --experimental-strip-types --disable-warning=ExperimentalWarning \"$CLAUDE_PROJECT_DIR/ai-framework/hooks/scripts/workflow-capture.mts\" --vendor claude --root \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 5
          }
        ],
        "description": "Record workflow activity metadata without prompt, response or transcript text"
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "AI_WORKFLOW_RUNNER=node node --experimental-strip-types --disable-warning=ExperimentalWarning \"$CLAUDE_PROJECT_DIR/ai-framework/hooks/scripts/workflow-capture.mts\" --vendor claude --root \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 5
          }
        ],
        "description": "Record workflow activity metadata without prompt, response or transcript text"
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "AI_WORKFLOW_RUNNER=node node --experimental-strip-types --disable-warning=ExperimentalWarning \"$CLAUDE_PROJECT_DIR/ai-framework/hooks/scripts/workflow-capture.mts\" --vendor claude --root \"$CLAUDE_PROJECT_DIR\"",
            "timeout": 5
          }
        ],
        "description": "Record workflow activity metadata without prompt, response or transcript text"
      }
    ]
  }
}
