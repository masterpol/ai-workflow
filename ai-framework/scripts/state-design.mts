/*
 * The one stylesheet and the one page shell for every state-report page. Tokens come from
 * state-theme's safeTheme (re-validated here), the layout is a sidebar plus content, and nothing
 * is scripted or loaded from outside. The CSP meta is the first child of <head>, because a meta
 * policy only governs content that follows it. See ai-framework/integrations/state-report.md.
 */
import { safeTheme } from "./state-theme.mts";
import type { Theme } from "./state-theme.mts";

export const GENERATOR_MARKER = "<!-- generated by state-render -->";
export const PAGE_NAMES = ["index", "structure", "skills", "metrics", "knowledge", "pitches"] as const;
export const PAGE_TITLES: Record<string, string> = { index: "Overview", structure: "Structure", skills: "Skills", metrics: "Metrics", knowledge: "Knowledge", pitches: "Pitches", state: "Full report" };

/** Named places where reviewed AI fragments may be placed later. With no fragments a slot is empty, so a page is byte-identical. */
export const SLOT_NAMES = ["overview", "architecture", "history", "risks", "tokens"] as const;
/** Classes an AI fragment may use; the container CSS for them is added with the loader. */
export const FRAGMENT_CLASSES = ["frag-note", "frag-card", "frag-grid", "frag-muted", "frag-figure"] as const;
export const slot = (_name: (typeof SLOT_NAMES)[number]): string => "";

const vars = (t: Theme["light"]): string => `--bg:${t.background};--fg:${t.foreground};--primary:${t.primary};--primary-fg:${t.primaryForeground};--muted:${t.muted};--muted-fg:${t.mutedForeground};--border:${t.border};--radius:${t.radius};--background:var(--bg);--foreground:var(--fg);--primaryForeground:var(--primary-fg);--mutedForeground:var(--muted-fg);`;

export function stylesheet(theme: Theme): string {
  const safe = safeTheme(theme);
  return `:root{color-scheme:light dark;${vars(safe.light)}--sans:${safe.light.fontSans};--mono:${safe.light.fontMono};--t-sm:.85rem;--t-md:1rem;--t-lg:1.25rem;--t-xl:1.7rem;--s-1:.5rem;--s-2:1rem;--s-3:1.5rem}
@media (prefers-color-scheme:dark){:root{${vars(safe.dark)}--sans:${safe.dark.fontSans};--mono:${safe.dark.fontMono};}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font-family:var(--sans);font-size:var(--t-md);line-height:1.5}
.layout{display:grid;grid-template-columns:15rem minmax(0,1fr);min-height:100vh}
.side{background:var(--muted);border-right:1px solid var(--border);padding:var(--s-2) var(--s-1);align-self:start;position:sticky;top:0;height:100vh;overflow:auto}
.brand{margin:0 0 var(--s-1) .75rem;font-weight:700;overflow-wrap:anywhere}
.side ul{display:block;margin:0;padding:0;list-style:none}
.side a{display:flex;align-items:center;min-height:44px;padding:0 .75rem;border-radius:var(--radius);color:var(--fg);text-decoration:none}
.side a:hover{text-decoration:underline}
.side a[aria-current="page"]{background:var(--primary);color:var(--primary-fg);font-weight:700}
.content header,.content main{max-width:64rem;margin:0 auto;padding:var(--s-2) var(--s-3)}
.content header{border-bottom:1px solid var(--border)}
h1{margin:.2rem 0;font-size:var(--t-xl)}h2{margin:2rem 0 .5rem;font-size:var(--t-lg)}h3{margin:1.2rem 0 .4rem;font-size:var(--t-md)}
.meta{margin:0;color:var(--muted-fg);font-size:var(--t-sm)}
a{color:var(--primary)}
a:focus-visible,.scroll:focus-visible,summary:focus-visible{outline:3px solid var(--primary);outline-offset:2px}
.skip{position:absolute;left:-999px}.skip:focus{left:1rem;top:1rem;z-index:1;background:var(--primary);color:var(--primary-fg);padding:.4rem .8rem;border-radius:var(--radius)}
main nav ul{display:flex;flex-wrap:wrap;gap:.25rem 1rem;padding:0;margin:0;list-style:none}
main nav a{display:inline-flex;align-items:center;min-height:44px;padding:0 .6rem}
.scroll{overflow-x:auto;border:1px solid var(--border);border-radius:var(--radius)}
table{width:100%;border-collapse:collapse;font-size:.92rem}
caption{text-align:left;padding:.5rem .7rem;color:var(--muted-fg)}
th,td{padding:.5rem .7rem;text-align:left;vertical-align:top;border-top:1px solid var(--border)}
thead th{background:var(--muted);color:var(--fg)}
tbody th{font-weight:600}
.sub,.none{color:var(--muted-fg);font-weight:400}
td,th,a,code{overflow-wrap:anywhere}
code{font-family:var(--mono);font-size:.85em}
dl{margin:0}dt{font-weight:600}dd{margin:0 0 .3rem 1rem}ul{margin:0;padding-left:1.1rem}
.legend{display:grid;grid-template-columns:max-content 1fr;gap:.4rem 1rem;align-items:center}.legend dd{margin:0}
.status{display:inline-block;padding:0 .5rem;border:1px solid var(--border);border-radius:999px;background:var(--muted);color:var(--fg);font-size:var(--t-sm);font-weight:600;white-space:nowrap}
.status-unavailable,.status-stale,.status-unconfigured,.status-proposed,.status-unknown{border:2px dashed var(--fg)}
.summary{font-weight:600}
.tree,.tree ul{list-style:none;margin:0;padding-left:1.2rem}.tree{padding-left:0}.tree li{border-left:2px solid var(--border);padding:.15rem 0 .15rem .6rem}
.tree .role{color:var(--muted-fg);margin-left:.5rem}.type{font-size:var(--t-md)}
tr:target{outline:2px solid var(--primary)}
details{margin:.2rem 0}summary{cursor:pointer;color:var(--muted-fg);min-height:44px;display:flex;align-items:center}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(11rem,1fr));gap:.75rem;padding:0;list-style:none}
.cards li{border:1px solid var(--border);border-radius:var(--radius);padding:.7rem;background:var(--muted)}
.chart{margin:.5rem 0}.chart svg{display:block;max-width:100%;height:auto}.chart-bar{fill:var(--primary)}.chart-label,.chart-value{fill:var(--fg);font-family:var(--sans);font-size:12px}.chart table{margin-top:.5rem}
.cards .label{display:block;color:var(--muted-fg);font-size:var(--t-sm)}.cards .value{display:block;font-size:var(--t-xl);font-weight:700}
.ai-analysis{border:2px dashed var(--fg);border-radius:var(--radius);padding:.75rem;margin:1rem 0}.ai-analysis>h2{margin-top:0}.ai-analysis footer{color:var(--muted-fg);font-size:var(--t-sm)}
.frag-note,.frag-muted{color:var(--muted-fg)}.frag-card{border:1px solid var(--border);border-radius:var(--radius);padding:.7rem;background:var(--muted)}.frag-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(11rem,1fr));gap:.75rem}.frag-figure{margin:.5rem 0}.frag-figure svg{max-width:100%;height:auto}
@media (max-width:640px){.layout{display:block}.side{position:static;height:auto;border-right:0;border-bottom:1px solid var(--border)}.side ul{display:flex;flex-wrap:wrap;gap:.25rem}.content header,.content main{padding:.75rem}table{font-size:.85rem}.legend{grid-template-columns:1fr}.scroll tbody th{position:sticky;left:0;background:var(--bg)}.chart svg{display:none}.tree ul{padding-left:.5rem}.tree li{padding-left:.4rem}}
@media print{h2{break-after:avoid}:root{--bg:#fff;--fg:#000;--primary:#000;--primary-fg:#fff;--muted:#eee;--muted-fg:#333;--border:#999}.side,main nav,.skip{display:none}.layout{display:block}.scroll{overflow:visible;border:0}tr{break-inside:avoid}a{color:#000;text-decoration:underline}details>ul{display:block}details::details-content{content-visibility:visible;display:block}}
`;
}

export interface ShellContext { name: string; generated: string; theme: unknown; version?: string; heading?: string; summary?: string }

export function createStateDesign(h: { esc: (value: unknown) => string; CSP: string }) {
  const { esc, CSP } = h;
  function shell(page: string, body: string, ctx: ShellContext): string {
    const links = [...PAGE_NAMES, "state"].map((n) => `<li><a href="${n}.html"${n === page ? ` aria-current="page"` : ""}>${esc(PAGE_TITLES[n])}</a></li>`).join("");
    const title = ctx.heading ?? PAGE_TITLES[page];
    const meta = [ctx.version ? `workflow ${esc(ctx.version)}` : "", `generated ${esc(ctx.generated)}`].filter(Boolean).join(" · ");
    return `<!doctype html>
${GENERATOR_MARKER}
<html lang="en">
<head>
<meta http-equiv="Content-Security-Policy" content="${CSP}">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>${esc(title)} — ${esc(ctx.name)}</title>
<style>
${stylesheet(ctx.theme as Theme)}</style>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<div class="layout">
<nav class="side" aria-label="Report pages"><p class="brand">${esc(ctx.name)}</p><ul>${links}</ul></nav>
<div class="content">
<header><h1>${esc(title)} — ${esc(ctx.name)}</h1><p class="meta">${meta}</p>${ctx.summary ? `<p class="summary">${esc(ctx.summary)}</p>` : ""}</header>
<main id="main">
${body}
</main>
</div>
</div>
</body>
</html>
`;
  }
  return { shell, stylesheet };
}
