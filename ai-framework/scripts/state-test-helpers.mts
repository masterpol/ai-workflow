// Markup-agnostic invariants for generated state-report pages. They check the safety properties of the
// output, not its layout, so a redesign can change markup without weakening any guard.
import { PAIRS, ratioOf, MIN_CONTRAST } from "./state-theme.mts";

// Plain throws, not node:assert: production-path files may not import Node built-ins (runtime boundary).
const check = (condition: unknown, message: string): void => { if (!condition) throw new Error(message); };

const HTML_TAGS = ["html", "head", "meta", "title", "style", "body", "a", "header", "h1", "h2", "h3", "p", "nav", "ul", "li", "main", "section", "div", "table", "caption", "thead", "tr", "th", "tbody", "td", "span", "br", "code", "dl", "dt", "dd", "details", "summary", "footer", "aside", "strong", "em", "ol", "h4", "pre", "data"];
const SVG_TAGS = ["svg", "g", "rect", "text", "line", "path", "circle", "desc", "ellipse", "polyline", "polygon", "tspan", "title"];
const ALLOWED_TAGS = new Set([...HTML_TAGS, ...SVG_TAGS]);
const HTML_ATTRS = ["lang", "charset", "name", "content", "http-equiv", "class", "href", "id", "aria-label", "aria-labelledby", "aria-current", "aria-hidden", "role", "tabindex", "scope", "colspan", "open", "value"];
const SVG_ATTRS = ["viewBox", "width", "height", "x", "y", "rx", "ry", "x1", "x2", "y1", "y2", "cx", "cy", "r", "d", "fill", "stroke", "stroke-width", "text-anchor", "preserveAspectRatio", "focusable", "xmlns", "points", "dx", "dy", "transform"];
const ALLOWED_ATTRS = new Set([...HTML_ATTRS, ...SVG_ATTRS]);

const TAG = /<([a-zA-Z][a-zA-Z0-9]*)((?:\s+[a-zA-Z][a-zA-Z0-9:-]*(?:="[^"]*")?)*)\s*\/?>/g;
const withoutStyle = (html: string) => html.replace(/<style>[\s\S]*?<\/style>/, "<style></style>");

export function assertInert(html: string): void {
  check(!/<script/i.test(html), "no <script>");
  check(!/\son[a-z]+\s*=/i.test(html), "no on* handler attribute");
  check(!/\s(?:src|action|data)=/i.test(html), "no src=, action= or data=");
  check(!/(?:https?:)?\/\/[a-z0-9.-]+\.[a-z]{2,}/i.test(html.replace(/http-equiv|www\.w3\.org/g, "")), "no external URL");
  check(!/url\(|@import|expression\(/i.test(html), "no url(, @import or expression(");
  check(!/\sstyle\s*=/i.test(html), "no style= attribute");
  check(!/\bfilter\s*[:=]/i.test(html), "no filter");
  for (const svg of html.matchAll(/<svg\b[\s\S]*?<\/svg>/gi)) {
    check(!/<(?:style|use|image|foreignObject|animate\w*)\b/i.test(svg[0]), "no style, use, image, foreignObject or animate inside an SVG");
  }
}

export function assertCspFirst(html: string): void {
  const head = html.match(/<head>\s*([\s\S]*?)<\/head>/);
  check(head, "has a <head>");
  check(/^<meta http-equiv="Content-Security-Policy" content="default-src 'none'/.test(head[1]), "the CSP meta is the first child of <head>");
  const at = html.indexOf("<meta charset=");
  const charset = at < 0 ? -1 : new TextEncoder().encode(html.slice(0, at)).length;
  check(charset >= 0 && charset < 1024, "the charset meta sits inside the first 1,024 bytes");
}

export function assertKnownMarkup(html: string): void {
  const body = withoutStyle(html);
  for (const [, name, attrs] of body.matchAll(TAG)) {
    check(ALLOWED_TAGS.has(name), `unexpected tag <${name}>`);
    for (const [, attribute] of attrs.matchAll(/\s([a-zA-Z][a-zA-Z0-9:-]*)(?:="[^"]*")?/g)) check(ALLOWED_ATTRS.has(attribute), `unexpected attribute ${attribute} on <${name}>`);
  }
  // Every "<" that starts markup was matched above; a stray one means an escape was missed.
  const stripped = body.replace(/<!-- generated by state-render -->/g, "").replace(TAG, "").replace(/<\/[a-zA-Z][a-zA-Z0-9]*\s*>/g, "").replace(/<!doctype html>/i, "");
  check(!stripped.includes("<"), `unescaped "<" outside a known tag: ${stripped.slice(stripped.indexOf("<"), stripped.indexOf("<") + 60)}`);
}

// `pages` names the sibling *.html files that exist; a link to anything else is broken.
export function assertNavResolves(html: string, pages: Iterable<string>): void {
  const known = new Set(pages);
  const body = withoutStyle(html);
  const ids = [...body.matchAll(/\sid="([^"]*)"/g)].map((match) => match[1]);
  check(new Set(ids).size === ids.length, "ids are unique");
  const idSet = new Set(ids);
  for (const [, id] of body.matchAll(/href="#([^"]*)"/g)) check(idSet.has(id), `#${id} resolves`);
  for (const [, list] of body.matchAll(/aria-labelledby="([^"]*)"/g)) for (const id of list.split(/\s+/).filter(Boolean)) check(idSet.has(id), `aria-labelledby ${id} resolves`);
  for (const [, href] of body.matchAll(/href="([a-z]+\.html)"/g)) check(known.has(href), `${href} exists`);
}

export function assertThemeContrast(theme: Record<"light" | "dark", Record<string, string>>): void {
  for (const mode of ["light", "dark"] as const) for (const pair of PAIRS) check(ratioOf(theme[mode], pair) >= MIN_CONTRAST, `${mode} ${pair.join("/")} is at least ${MIN_CONTRAST}:1`);
}
