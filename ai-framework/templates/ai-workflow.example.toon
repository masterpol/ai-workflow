schemaVersion: 2
runtime:
  runner: node
integrations:
  orca:
    engine: "1.4.224"
    enabled: true
    multiAgent: true
    maxConcurrentWorkers: 3
    maxRetriesPerTask: 1
    coordinators:
      claude:
        workers[2]: codex,opencode
        roles:
          implementation[1]: opencode
          review[1]: codex
      codex:
        workers[2]: claude,opencode
        roles:
          implementation[1]: claude
          review[1]: opencode
      opencode:
        workers[2]: claude,codex
        roles:
          implementation[1]: claude
          review[1]: codex
doctor:
  modelRouting: project
skills:
  modes:
    caveman: full
