# Workflow script runtime: node (default) or bun.
# Add this setting to the project-root .env, or use this file as a template for a new .env.
# A process environment value overrides .env.
# To use Bun, change the value to bun and ensure bun is available on PATH.
AI_WORKFLOW_RUNNER=bun

# Orca multi-agent dispatch: off unless this is exactly true. Anything else (unset, false, empty) keeps the normal workflow.
# Needs a policy in .project/orchestration.json and a supported Orca install; see ai-framework/integrations/orca-vendors.md.
# A process environment value overrides .env.
AI_WORKFLOW_ORCA_MULTI_AGENT=false
