{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/ai-framework/hooks/scripts/token-consumption.js\" --vendor claude --event agent-result --root \"$CLAUDE_PROJECT_DIR\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/ai-framework/hooks/scripts/token-consumption.js\" --vendor claude --event subagent-complete --root \"$CLAUDE_PROJECT_DIR\""
          }
        ]
      }
    ]
  }
}
